{
  "name": "wexample/symfony-user",
  "description": "User accounts and authentication for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "11.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyUser\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyUser\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/security-bundle": "^7.4",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-security": ">=2.1.0",
    "wexample/symfony-translations": ">=12.0.0",
    "symfony/validator": "^7.4",
    "wexample/symfony-forms": ">=11.0.0",
    "wexample/symfony-loader": ">=22.0.0",
    "wexample/symfony-mail": ">=2.0.0",
    "symfony/form": "^7.4",
    "symfony/rate-limiter": "^7.4",
    "symfony/mailer": "^7.4",
    "symfony/twig-bridge": "^7.4",
    "scheb/2fa-bundle": "^8.6",
    "scheb/2fa-trusted-device": "^8.6",
    "scheb/2fa-totp": "^8.6",
    "scheb/2fa-backup-code": "^8.6",
    "endroid/qr-code": "^6.0",
    "wexample/symfony-tunnels": ">=10.0.0",
    "wexample/symfony-activity": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/browser-kit": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/css-selector": "^7.4",
    "symfony/monolog-bundle": "^3.10",
    "wexample/symfony-user-ds": "*",
    "wexample/symfony-activity": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  },
  "suggest": {
    "symfony/monolog-bundle": "Writes the security journal to its own channel, user_security",
    "wexample/symfony-activity": "Keeps the security facts of each account as its history — the login history among them"
  }
}