{
  "name": "wexample/symfony-user",
  "description": "User accounts and authentication for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "7.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyUser\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyUser\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/security-bundle": "^7.4",
    "wexample/symfony-helpers": ">=11.0.0",
    "wexample/symfony-translations": ">=4.0.0",
    "symfony/validator": "^7.4",
    "wexample/symfony-forms": ">=8.0.0",
    "wexample/symfony-loader": ">=14.0.0",
    "symfony/form": "^7.4",
    "symfony/rate-limiter": "^7.4",
    "symfony/mailer": "^7.4",
    "symfony/twig-bridge": "^7.4",
    "scheb/2fa-bundle": "^8.6",
    "scheb/2fa-trusted-device": "^8.6",
    "scheb/2fa-totp": "^8.6",
    "scheb/2fa-backup-code": "^8.6",
    "endroid/qr-code": "^6.0",
    "wexample/symfony-tunnels": ">=8.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}