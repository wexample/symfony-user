{#- The account's own menu, opened from its initials: who is signed in at its
    head — and, when the application says it, as what (`role_labels`, one line
    each; `role_label` for a single one) —, the application's
    own entries (`items`), the authenticator app, the language, the
    application's closing entries (`items_end`: terms, policies), and leaving.
    Drawn by the design system's button_menu. -#}
{%- set user = app.user -%}
{%- set language_items = locale_menu_items() -%}
{%- set roles = role_labels|default(role_label|default(null) ? [role_label] : []) -%}
{%- set entries = [{ heading: user.displayName, lines: roles }]
    |merge(items|default([]))
    |merge([{ icon: 'ph:bold/shield-check', label: 'WexampleSymfonyUserBundle.common.menu::authenticator' | trans, href: path('user_totp_index') }]) -%}
{%- if language_items|length > 1 -%}
    {%- set entries = entries
        |merge([{ separator: true, label: 'WexampleSymfonyUserBundle.common.menu::language' | trans }])
        |merge(language_items) -%}
{%- endif -%}
{%- if items_end|default([]) is not empty -%}
    {%- set entries = entries|merge([{ separator: true }])|merge(items_end) -%}
{%- endif -%}
{%- set entries = entries|merge([
    { separator: true },
    { icon: 'ph:bold/sign-out', label: 'WexampleSymfonyUserBundle.common.menu::logout' | trans, href: path('user_security_logout') },
]) -%}
{{ button_menu(null, null, entries, {
    class: 'button--flat',
    avatar: user.initials,
    menu_align: 'right',
    attr: { 'aria-label': 'WexampleSymfonyUserBundle.common.menu::label' | trans, title: user.displayName },
}) }}
