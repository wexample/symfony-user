{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- A step of the authenticator setup: one thing to do, the steps ahead shown
    above it, the way back and on at the foot of its card. -#}
{%- set page_focus = true -%}
{%- set page_show_title = true -%}

{%- block page_body -%}
    {%- include '@WexampleSymfonyTunnelsBundle/partials/tunnel-navigation.html.twig' -%}
    <section class="block block--card">
        <div class="block--body stack--vertical">
            {%- block step_body -%}{%- endblock -%}
        </div>
        {%- set step_footer -%}{%- block step_footer -%}{%- include '@WexampleSymfonyTunnelsBundle/partials/tunnel-buttons.html.twig' -%}{%- endblock -%}{%- endset -%}
        {%- if step_footer|trim is not empty -%}
            <div class="block--footer">{{ step_footer }}</div>
        {%- endif -%}
    </section>
{%- endblock -%}
