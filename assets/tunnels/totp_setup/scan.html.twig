{%- extends '@WexampleSymfonyUserBundle/tunnels/totp_setup/_step.html.twig' -%}

{%- block step_body -%}
    {%- if required -%}
        <p class="lead">{{ '@page::required' | trans }}</p>
    {%- endif -%}
    <p class="{{ required ? 'text-secondary' : 'lead' }}">{{ '@page::intro' | trans }}</p>
    <p><img src="{{ qr_code }}" alt="{{ '@page::qr_alt' | trans }}" width="240" height="240"></p>
    <p class="text-secondary">{{ '@page::secret' | trans }} <code>{{ secret }}</code></p>
{%- endblock -%}
