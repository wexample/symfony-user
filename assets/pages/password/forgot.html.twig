{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- One thing to do and nothing around it: the layout's focus. -#}
{%- set page_focus = true -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {#- Sent back here by a link that no longer holds. -#}
    {%- if link_invalid -%}
        {{ message_warning('@page::link_invalid' | trans) }}
    {%- endif -%}

    <section class="block block--card">
        <div class="block--body">
            {{ form_load(render_pass, password_reset_request_form, '@WexampleSymfonyUserBundle/forms/password_reset_request_form.html.twig') }}
        </div>
    </section>

    {#- In development, the link is read in symfony-mail's mailbox — said
        apart and loud, so nobody takes it for part of the product. -#}
    {%- set mailbox = mailbox_url() -%}
    {%- if mailbox -%}
        {{ message_dev('@page::dev_mailbox.title', '@page::dev_mailbox.body', {
            action: { icon: 'ph:bold/envelope-simple', label: '@page::action.mailbox', href: mailbox, new_window: true },
        }) }}
    {%- endif -%}
{%- endblock -%}
