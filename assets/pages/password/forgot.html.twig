{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {#- Sent back here by a link that no longer holds. -#}
    {%- if link_invalid -%}
        {{ message_warning('@page::link_invalid' | trans) }}
    {%- endif -%}

    <section class="block block--card">
        <div class="block--body">
            {{ form_load(render_pass, password_reset_request_form, '@WexampleSymfonyUserBundle/forms/password_reset_request_form.html.twig') }}
        </div>
        {#- In development, the link is read in symfony-mail's mailbox. -#}
        {%- set mailbox = mailbox_url() -%}
        {%- if mailbox -%}
            <div class="block--footer">
                <span></span>
                {{ button_link('ph:bold/envelope-simple', '@page::action.mailbox' | trans, mailbox, { class: 'button--flat' }) }}
            </div>
        {%- endif -%}
    </section>
{%- endblock -%}
