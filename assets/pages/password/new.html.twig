{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- One thing to do and nothing around it: the layout's focus. -#}
{%- set page_focus = true -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {%- include '@WexampleSymfonyUserBundle/partials/activation_steps.html.twig' -%}
    <section class="block block--card">
        <div class="block--body stack--vertical">
            <p class="lead">{{ '@page::intro' | trans({'%email%': user.email}) }}</p>
            {{ form_load(render_pass, set_password_form, '@WexampleSymfonyUserBundle/forms/set_password_form.html.twig') }}
        </div>
    </section>
{%- endblock -%}
