{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- The only time the codes are shown: nothing keeps them in clear. -#}
{%- block page_body -%}
    <section class="block block--card">
        <div class="block--body stack--vertical">
            <p class="lead">{{ '@page::intro' | trans }}</p>
            <ul>
                {%- for code in codes -%}
                    <li><code>{{ code }}</code></li>
                {%- endfor -%}
            </ul>
        </div>
        <div class="block--footer">
            {{ button_link('ph:bold/check', '@page::action.done' | trans, path('user_totp_index')) }}
        </div>
    </section>
{%- endblock -%}
