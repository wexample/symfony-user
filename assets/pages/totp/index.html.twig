{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- The app set up: the backup codes left, and the way out. Setting it up is
    the setup tunnel's (tunnels/totp_setup). -#}
{%- block page_body -%}
    <section class="block block--card">
        <div class="block--body stack--vertical">
            <p class="lead">{{ '@page::enabled.intro' | trans }}</p>
            <p>{{ '@page::enabled.backup_codes' | trans({'%count%': backup_codes_count}) }}</p>
            <form method="post" action="{{ path('user_totp_regenerate') }}">
                {{ button('ph:bold/arrow-clockwise', '@page::action.regenerate' | trans, { type: 'submit' }) }}
            </form>
        </div>
    </section>
    <section class="block block--card">
        <div class="block--body stack--vertical">
            {%- if required -%}
                <p class="text-secondary">{{ '@page::disable.required' | trans }}</p>
            {%- else -%}
                <p>{{ '@page::disable.intro' | trans }}</p>
                {{ form_load(render_pass, totp_disable_form, '@WexampleSymfonyUserBundle/forms/totp_disable_form.html.twig') }}
            {%- endif -%}
        </div>
    </section>
{%- endblock -%}
